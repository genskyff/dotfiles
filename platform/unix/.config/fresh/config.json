{
  "editor": {
    "completion_popup_auto_show": true,
    "diagnostics_inline_text": true,
    "ensure_final_newline_on_save": true,
    "indentation_guide": "all",
    "nerd_font_icons": true,
    "rainbow_indentation": true,
    "trim_trailing_whitespace_on_save": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "preview_tabs": false,
    "show_gitignored": true,
    "show_hidden": true,
    "width": "20%"
  },
  "locale": "en",
  "plugins": {
    "dashboard": {
      "enabled": true,
      "settings": {
        "autoOpen": true
      }
    },
    "git_explorer": {
      "enabled": true,
      "settings": {
        "colorNames": true
      }
    }
  },
  "theme": "builtin://dark",
  "version": 2
}
